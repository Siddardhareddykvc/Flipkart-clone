@page
@model IndexModel
@{
    ViewData["Title"] = "Flipkart Clone";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    ```
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f1f3f6;
            font-family: Arial, Helvetica, sans-serif;
            color: #212121;
        }

        /* HEADER */
        .top-header {
            background: #2874f0;
            min-height: 65px;
            display: flex;
            align-items: center;
            padding: 8px 5%;
            gap: 25px;
            color: white;
        }

        .logo {
            min-width: 130px;
        }

        .logo h2 {
            font-size: 24px;
            font-weight: bold;
            font-style: italic;
            margin: 0;
        }

        .logo span {
            font-size: 12px;
            font-style: italic;
        }

        .logo span i {
            color: #ffe500;
        }

        .search-box {
            flex: 1;
            max-width: 600px;
            display: flex;
            height: 40px;
        }

        .search-box input {
            width: 100%;
            border: none;
            outline: none;
            padding: 0 15px;
            font-size: 14px;
            border-radius: 2px 0 0 2px;
        }

        .search-box button {
            width: 50px;
            border: none;
            background: white;
            color: #2874f0;
            border-radius: 0 2px 2px 0;
        }

        .header-btn {
            color: white;
            text-decoration: none;
            font-weight: 600;
            white-space: nowrap;
        }

        .header-btn:hover {
            color: #ffe500;
        }

        .cart {
            display: flex;
            gap: 7px;
            align-items: center;
        }

        /* CATEGORY NAVIGATION */
        .category-bar {
            background: white;
            min-height: 105px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 55px;
            box-shadow: 0 1px 3px rgba(0,0,0,.15);
            overflow-x: auto;
        }

        .category {
            min-width: 70px;
            text-align: center;
            cursor: pointer;
            white-space: nowrap;
        }

        .category img {
            width: 64px;
            height: 64px;
            object-fit: contain;
        }

        .category p {
            margin-top: 5px;
            font-size: 14px;
            font-weight: 600;
        }

        /* HERO */
        .hero {
            margin: 15px auto;
            width: 95%;
            height: 280px;
            background: linear-gradient(100deg, #0d47a1, #2874f0);
            border-radius: 3px;
            overflow: hidden;
            position: relative;
            color: white;
            display: flex;
            align-items: center;
            padding: 40px 7%;
        }

        .hero-content {
            max-width: 500px;
            z-index: 2;
        }

        .hero h1 {
            font-size: 40px;
            font-weight: bold;
        }

        .hero p {
            font-size: 19px;
            margin: 10px 0 20px;
        }

        .shop-btn {
            display: inline-block;
            background: #ff9f00;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 3px;
        }

        .shop-btn:hover {
            background: #fb641b;
            color: white;
        }

        .hero-circle {
            position: absolute;
            width: 350px;
            height: 350px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
            right: 10%;
        }

        /* SECTION */
        .section {
            width: 95%;
            margin: 15px auto;
            background: white;
            box-shadow: 0 1px 3px rgba(0,0,0,.15);
        }

        .section-header {
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-header h3 {
            font-size: 22px;
            font-weight: 600;
            margin: 0;
        }

        .view-btn {
            background: #2874f0;
            color: white;
            padding: 9px 18px;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            border-radius: 2px;
        }

        /* PRODUCTS */
        .products {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            padding: 20px;
        }

        .product {
            text-align: center;
            padding: 15px;
            cursor: pointer;
            transition: .2s;
            border-radius: 4px;
        }

        .product:hover {
            box-shadow: 0 3px 12px rgba(0,0,0,.15);
            transform: translateY(-3px);
        }

        .product img {
            width: 100%;
            height: 180px;
            object-fit: contain;
            margin-bottom: 12px;
        }

        .product h5 {
            font-size: 15px;
            margin-bottom: 8px;
        }

        .price {
            font-size: 17px;
            font-weight: bold;
        }

        .old-price {
            color: #878787;
            text-decoration: line-through;
            margin-left: 5px;
            font-size: 13px;
        }

        .discount {
            color: #388e3c;
            font-size: 13px;
            font-weight: bold;
            margin-left: 5px;
        }

        .rating {
            background: #388e3c;
            color: white;
            padding: 3px 7px;
            border-radius: 3px;
            font-size: 12px;
            display: inline-block;
            margin-bottom: 5px;
        }

        /* OFFER BANNERS */
        .offer-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            padding: 20px;
        }

        .offer {
            height: 180px;
            border-radius: 5px;
            color: white;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .offer h3 {
            font-size: 23px;
            font-weight: bold;
        }

        .offer p {
            margin: 5px 0 15px;
        }

        .offer a {
            width: fit-content;
            background: white;
            color: #2874f0;
            padding: 8px 15px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 3px;
        }

        .offer1 {
            background: linear-gradient(120deg, #673ab7, #9c27b0);
        }

        .offer2 {
            background: linear-gradient(120deg, #ff6f00, #ff9800);
        }

        .offer3 {
            background: linear-gradient(120deg, #00897b, #00acc1);
        }

        /* FOOTER */
        footer {
            background: #172337;
            color: #fff;
            margin-top: 30px;
            padding: 40px 6% 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        footer h5 {
            color: #878787;
            font-size: 13px;
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        footer a {
            display: block;
            color: white;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 10px;
        }

        footer a:hover {
            text-decoration: underline;
        }

        .footer-bottom {
            border-top: 1px solid #454d5e;
            margin-top: 30px;
            padding-top: 20px;
            text-align: center;
            font-size: 13px;
            color: #aaa;
        }

        /* RESPONSIVE */
        @@media (max-width: 992px) {
            .top-header {
                flex-wrap: wrap;
            }

            .search-box {
                order: 3;
                flex-basis: 100%;
                max-width: 100%;
            }

            .products {
                grid-template-columns: repeat(3, 1fr);
            }

            .offer-container {
                grid-template-columns: 1fr;
            }

            .category-bar {
                justify-content: flex-start;
                padding: 10px 20px;
            }
        }

        @@media (max-width: 600px) {
            .top-header {
                padding: 10px 15px;
                gap: 15px;
            }

            .logo {
                min-width: auto;
            }

            .header-btn {
                font-size: 12px;
            }

            .hero {
                height: 230px;
                padding: 25px;
            }

            .hero h1 {
                font-size: 27px;
            }

            .hero p {
                font-size: 15px;
            }

            .products {
                grid-template-columns: repeat(2, 1fr);
                padding: 10px;
                gap: 5px;
            }

            .product img {
                height: 130px;
            }

            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
    ```

</head>

<body>

    ```
    <!-- HEADER -->
    <header class="top-header">

        <div class="logo">
            <h2>Flipkart</h2>
            <span>Explore <i>Plus</i></span>
        </div>

        <div class="search-box">
            <input type="text"
                   placeholder="Search for products, brands and more" />

            <button type="button">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>

        <a href="#" class="header-btn">
            Login
        </a>

        <a href="#" class="header-btn">
            Become a Seller
        </a>

        <a href="#" class="header-btn">
            More <i class="fa-solid fa-angle-down"></i>
        </a>

        <a href="#" class="header-btn cart">
            <i class="fa-solid fa-cart-shopping"></i>
            Cart
        </a>

    </header>


    <!-- CATEGORY BAR -->
    <div class="category-bar">

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/3081/3081559.png"
                 alt="Grocery">
            <p>Grocery</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/2920/2920254.png"
                 alt="Mobiles">
            <p>Mobiles</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/2454/2454282.png"
                 alt="Fashion">
            <p>Fashion</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/1041/1041886.png"
                 alt="Electronics">
            <p>Electronics</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/3082/3082031.png"
                 alt="Home">
            <p>Home</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/3004/3004458.png"
                 alt="Appliances">
            <p>Appliances</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/2936/2936886.png"
                 alt="Travel">
            <p>Travel</p>
        </div>

        <div class="category">
            <img src="https://cdn-icons-png.flaticon.com/512/3048/3048123.png"
                 alt="Toys">
            <p>Beauty & Toys</p>
        </div>

    </div>


    <!-- HERO BANNER -->
    <section class="hero">

        <div class="hero-circle"></div>

        <div class="hero-content">

            <h1>Big Billion Days</h1>

            <p>
                Great deals on mobiles, electronics,
                fashion and more.
            </p>

            <a href="#" class="shop-btn">
                Shop Now
            </a>

        </div>

    </section>


    <!-- DEALS SECTION -->
    <section class="section">

        <div class="section-header">

            <h3>Best Deals</h3>

            <a href="#" class="view-btn">
                VIEW ALL
            </a>

        </div>


        <div class="products">

            <!-- PRODUCT 1 -->
            <div class="product">

                <img src="https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?w=500"
                     alt="Smartphone">

                <h5>Premium Smartphone</h5>

                <div>
                    <span class="rating">
                        4.4 ★
                    </span>
                </div>

                <div class="price">
                    ₹14,999

                    <span class="old-price">
                        ₹19,999
                    </span>

                    <span class="discount">
                        25% off
                    </span>
                </div>

            </div>


            <!-- PRODUCT 2 -->
            <div class="product">

                <img src="https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=500"
                     alt="Headphones">

                <h5>Wireless Headphones</h5>

                <div>
                    <span class="rating">
                        4.3 ★
                    </span>
                </div>

                <div class="price">
                    ₹1,499

                    <span class="old-price">
                        ₹2,999
                    </span>

                    <span class="discount">
                        50% off
                    </span>
                </div>

            </div>


            <!-- PRODUCT 3 -->
            <div class="product">

                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500"
                     alt="Smart Watch">

                <h5>Smart Watch</h5>

                <div>
                    <span class="rating">
                        4.5 ★
                    </span>
                </div>

                <div class="price">
                    ₹2,499

                    <span class="old-price">
                        ₹4,999
                    </span>

                    <span class="discount">
                        50% off
                    </span>
                </div>

            </div>


            <!-- PRODUCT 4 -->
            <div class="product">

                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500"
                     alt="Shoes">

                <h5>Running Shoes</h5>

                <div>
                    <span class="rating">
                        4.2 ★
                    </span>
                </div>

                <div class="price">
                    ₹1,799

                    <span class="old-price">
                        ₹3,499
                    </span>

                    <span class="discount">
                        49% off
                    </span>
                </div>

            </div>


            <!-- PRODUCT 5 -->
            <div class="product">

                <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500"
                     alt="T Shirt">

                <h5>Men's T-Shirt</h5>

                <div>
                    <span class="rating">
                        4.1 ★
                    </span>
                </div>

                <div class="price">
                    ₹599

                    <span class="old-price">
                        ₹1,299
                    </span>

                    <span class="discount">
                        54% off
                    </span>
                </div>

            </div>

        </div>

    </section>


    <!-- MORE PRODUCTS -->
    <section class="section">

        <div class="section-header">

            <h3>Trending Products</h3>

            <a href="#" class="view-btn">
                VIEW ALL
            </a>

        </div>


        <div class="products">

            <div class="product">

                <img src="https://images.unsplash.com/photo-1517336714739-489689fd1ca8?w=500"
                     alt="Laptop">

                <h5>Laptop</h5>

                <div class="price">
                    ₹49,999
                </div>

                <span class="discount">
                    20% off
                </span>

            </div>


            <div class="product">

                <img src="https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?w=500"
                     alt="Speaker">

                <h5>Bluetooth Speaker</h5>

                <div class="price">
                    ₹999
                </div>

                <span class="discount">
                    40% off
                </span>

            </div>


            <div class="product">

                <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=500"
                     alt="Cosmetics">

                <h5>Beauty Products</h5>

                <div class="price">
                    ₹799
                </div>

                <span class="discount">
                    35% off
                </span>

            </div>


            <div class="product">

                <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=500"
                     alt="Furniture">

                <h5>Home Furniture</h5>

                <div class="price">
                    ₹6,999
                </div>

                <span class="discount">
                    30% off
                </span>

            </div>


            <div class="product">

                <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=500"
                     alt="Gaming Console">

                <h5>Gaming Console</h5>

                <div class="price">
                    ₹29,999
                </div>

                <span class="discount">
                    15% off
                </span>

            </div>

        </div>

    </section>


    <!-- OFFER BANNERS -->
    <section class="section">

        <div class="section-header">

            <h3>Special Offers</h3>

        </div>

        <div class="offer-container">

            <div class="offer offer1">

                <h3>Electronics Sale</h3>

                <p>Up to 60% off on electronics</p>

                <a href="#">Shop Now</a>

            </div>


            <div class="offer offer2">

                <h3>Fashion Deals</h3>

                <p>Latest styles at amazing prices</p>

                <a href="#">Explore</a>

            </div>


            <div class="offer offer3">

                <h3>Home & Living</h3>

                <p>Upgrade your home today</p>

                <a href="#">Discover</a>

            </div>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>

        <div class="footer-grid">

            <div>
                <h5>About</h5>

                <a href="#">Contact Us</a>
                <a href="#">About Us</a>
                <a href="#">Careers</a>
                <a href="#">Corporate Information</a>
            </div>


            <div>
                <h5>Help</h5>

                <a href="#">Payments</a>
                <a href="#">Shipping</a>
                <a href="#">Cancellation & Returns</a>
                <a href="#">FAQ</a>
            </div>


            <div>
                <h5>Consumer Policy</h5>

                <a href="#">Cancellation & Returns</a>
                <a href="#">Terms Of Use</a>
                <a href="#">Security</a>
                <a href="#">Privacy</a>
            </div>


            <div>
                <h5>Social</h5>

                <a href="#">Facebook</a>
                <a href="#">Twitter</a>
                <a href="#">YouTube</a>
                <a href="#">Instagram</a>
            </div>

        </div>


        <div class="footer-bottom">

            © @DateTime.Now.Year Flipkart Clone. All rights reserved.

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
